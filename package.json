{
  "name": "@tweenframe/cli",
  "version": "0.1.0",
  "description": "Command-line client for the TweenFrame public recipe API: render animated GIFs, videos and images from recipes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsitecontrol/tweenframe-cli.git"
  },
  "homepage": "https://github.com/getsitecontrol/tweenframe-cli#readme",
  "bugs": {
    "url": "https://github.com/getsitecontrol/tweenframe-cli/issues"
  },
  "keywords": [
    "tweenframe",
    "cli",
    "gif",
    "animation",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "tweenframe": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "npm run generate && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "npm run generate:check && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "15.0.0"
  }
}
