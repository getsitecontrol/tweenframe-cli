{
  "name": "@tweenframe/cli",
  "version": "0.1.0",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "tweenframe": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "npm run generate && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "npm run generate:check && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "15.0.0"
  }
}
