{
  "openapi": "3.1.0",
  "info": {
    "title": "TweenFrame Public API",
    "version": "0.2.0",
    "description": "Render curated catalog recipes into animated GIF, WebP, APNG, MP4, WebM or still images.\n\nFlow: create an anonymous identity (POST /identity), pick a recipe (GET /recipes), read its input_schema and examples (GET /recipes/{id}), upload local images as assets (POST /assets), post a render (POST /renders) and poll it until it completes (GET /renders/{jobKey}).\n\nEvery error is `{error: {code, message, details?, hint, docs}}`: `hint` says what to do next and `docs` links the code's section in the errors guide.\n\nGuides (origin-relative, plain Markdown): skill /docs/agent/SKILL.md, recipes /docs/agent/recipes.md, output /docs/agent/output.md, assets /docs/agent/assets.md, errors /docs/agent/errors.md, HTTP API /docs/agent/api.md; index /docs/agent/index.json.",
    "x-cli": {
      "description": "Render TweenFrame catalog recipes (animated GIF, WebP, video) from the command line. Results print as one JSON document on stdout, errors as one on stderr with a hint and a docs link.",
      "docs": "/docs/agent/SKILL.md",
      "index": "/docs/agent/index.json"
    }
  },
  "servers": [
    {
      "url": "/api/public/v1"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Anonymous bearer identity: create a token once and reuse it for a year.",
      "externalDocs": {
        "url": "/docs/agent/SKILL.md"
      }
    },
    {
      "name": "recipes",
      "description": "Catalog of public recipes: list them, read one's inputs and examples, render it.",
      "externalDocs": {
        "url": "/docs/agent/recipes.md"
      }
    },
    {
      "name": "assets",
      "description": "Images for recipe inputs: upload them; analyzing one for a focal point and crops is optional.",
      "externalDocs": {
        "url": "/docs/agent/assets.md"
      }
    },
    {
      "name": "renders",
      "description": "Render jobs: resume polling a render that is still pending.",
      "externalDocs": {
        "url": "/docs/agent/recipes.md"
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token from POST /identity, valid for one year. Send it as `Authorization: Bearer <token>`."
      }
    },
    "responses": {
      "400": {
        "description": "Malformed request (invalid_json, bad_request)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Missing, invalid or expired bearer token (token_required, unauthorized, poll_token_required)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "The token may not use this resource (asset_forbidden, invalid_poll_token)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Unknown recipe or version (recipe_not_found), or unknown job",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "The catalog recipe and the render service disagree (recipe_revision_mismatch, sdk_incompatible, …)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "413": {
        "description": "Upload larger than 25 MB, render request larger than 256 KB or analyze request larger than 16 KB (payload_too_large)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "415": {
        "description": "Wrong Content-Type (unsupported_media_type)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "422": {
        "description": "Request, inputs or output options rejected (invalid_request, invalid_recipe_inputs, invalid_output, …); details.path points at the offending value",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "429": {
        "description": "Quota for this period spent (quota_exceeded)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "500": {
        "description": "Server error (studio_unavailable, released_recipe_invalid, …)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "502": {
        "description": "Render service unreachable or failing (upstream_unavailable, upstream_error)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "504": {
        "description": "Render service timed out (upstream_timeout)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code; errors.md has a section per code."
          },
          "message": {
            "type": "string",
            "description": "What went wrong, for a human or an agent."
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Extra context; `path` names the offending value as a list of keys and indexes."
          },
          "hint": {
            "type": "string",
            "description": "One sentence: what to do next."
          },
          "docs": {
            "type": "string",
            "description": "Origin-relative URL of this code's section in errors.md."
          },
          "reference": {
            "type": "string",
            "description": "Recipe detail URL (GET /recipes/{id}) whose input_schema the invalid input breaks."
          },
          "output_reference": {
            "type": "string",
            "description": "URL of the OutputOptions schema, on 422 from POST /renders."
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "docs"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ]
      },
      "AnonymousIdentity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Public subject id of the identity."
          },
          "token": {
            "type": "string",
            "description": "Bearer token for authenticated calls. Keep it secret."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the token stops working (one year after creation)."
          },
          "docs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Guides to read next: `skill` and `api`."
          }
        },
        "required": [
          "id",
          "token",
          "expires_at"
        ]
      },
      "Asset": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Asset id."
          },
          "url": {
            "type": "string",
            "description": "Managed asset URL; put it into recipe inputs at an asset path. Usable only with the token that uploaded it."
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 of the stored bytes."
          },
          "ext": {
            "type": "string",
            "description": "File extension: jpg, png, webp or gif."
          },
          "content_type": {
            "type": "string",
            "description": "MIME type of the stored file."
          },
          "width": {
            "type": "integer",
            "description": "Width in pixels."
          },
          "height": {
            "type": "integer",
            "description": "Height in pixels."
          },
          "byte_size": {
            "type": "integer",
            "description": "Stored size in bytes."
          },
          "catalog": {
            "type": [
              "string",
              "null"
            ],
            "description": "Always null for uploads."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Always empty for uploads."
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "docs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Guide to read next: `guide` (assets)."
          }
        },
        "required": [
          "id",
          "url",
          "sha256",
          "ext",
          "content_type",
          "width",
          "height",
          "byte_size"
        ]
      },
      "AnalyzeRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Managed asset URL from POST /assets, or a catalog asset path (/template-catalog/assets/…) from a recipe example."
          },
          "aspects": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$"
            },
            "description": "Canvas aspects (width:height, each side 1-9999, e.g. 4:5) to suggest a cover crop for; at most 16."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "AnalysisPoint": {
        "type": "object",
        "description": "A point normalized 0..1 against the oriented image.",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "AnalysisCrop": {
        "type": "object",
        "description": "The cover crop for one aspect, normalized 0..1.",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "object_position": {
            "$ref": "#/components/schemas/AnalysisPoint"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h",
          "object_position"
        ]
      },
      "AnalysisFace": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "score": {
            "type": "number"
          },
          "primary": {
            "type": "boolean",
            "description": "Part of the set that steered the focal point."
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h",
          "score",
          "primary"
        ]
      },
      "AssetAnalysis": {
        "type": "object",
        "properties": {
          "contract_version": {
            "type": "integer"
          },
          "model_version": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "image": {
            "type": "object",
            "description": "Oriented original size in pixels.",
            "properties": {
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "orientation_applied": {
                "type": "boolean"
              }
            },
            "required": [
              "width",
              "height",
              "orientation_applied"
            ]
          },
          "focal": {
            "type": "object",
            "description": "Focal point normalized 0..1; use [x, y] as a recipe `focus` value. source: face, saliency or center (nothing found).",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "source": {
                "type": "string",
                "enum": [
                  "face",
                  "saliency",
                  "center"
                ]
              },
              "confidence": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "source",
              "confidence"
            ]
          },
          "subject": {
            "type": [
              "object",
              "null"
            ],
            "description": "Region to keep in frame; null when focal.source is center.",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          },
          "object_position": {
            "$ref": "#/components/schemas/AnalysisPoint"
          },
          "faces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnalysisFace"
            }
          },
          "crops": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AnalysisCrop"
            },
            "description": "Suggested cover crop per requested aspect, keyed as requested (e.g. 4:5)."
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal notes about the analysis, e.g. a low-confidence result.",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          },
          "docs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Guide to read next: `guide` (assets)."
          }
        },
        "required": [
          "contract_version",
          "model_version",
          "image",
          "focal",
          "subject",
          "object_position",
          "faces",
          "crops",
          "warnings"
        ]
      },
      "RecipeSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Recipe id, e.g. real-estate/banner-7."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Catalog version; renders use it unless you pin another."
          },
          "title": {
            "type": "string",
            "description": "Short human title."
          },
          "description": {
            "type": "string",
            "description": "What this recipe makes."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Search tags."
          },
          "preview_url": {
            "type": "string",
            "format": "uri-reference",
            "description": "Still preview image, a path on the API origin."
          },
          "inputs_summary": {
            "$ref": "#/components/schemas/InputsSummary"
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "description",
          "tags",
          "preview_url",
          "inputs_summary"
        ]
      },
      "InputsSummary": {
        "type": "object",
        "description": "What a caller must bring, at a glance; GET /recipes/{id} has the full schema.",
        "properties": {
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Top-level inputs without a default. For most recipes these are the user's own data."
          },
          "assets": {
            "type": "array",
            "description": "Image inputs: where they go and how many.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Path inside inputs as in asset_paths; '*' = every list item."
                },
                "min": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Fewest images to send."
                },
                "max": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Most images accepted; null = no limit."
                }
              },
              "required": [
                "path",
                "min",
                "max"
              ]
            }
          },
          "texts": {
            "type": "integer",
            "minimum": 0,
            "description": "Text fields (a field inside list items counts once)."
          },
          "colors": {
            "type": "integer",
            "minimum": 0,
            "description": "Color and fill fields."
          },
          "lists": {
            "type": "integer",
            "minimum": 0,
            "description": "List inputs."
          },
          "media": {
            "type": "integer",
            "minimum": 0,
            "description": "Media inputs (a picture, GIF or video with focus and crop); a list of media counts once."
          }
        },
        "required": [
          "required",
          "assets",
          "texts",
          "colors",
          "lists",
          "media"
        ]
      },
      "RecipeList": {
        "type": "object",
        "properties": {
          "recipes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeSummary"
            }
          },
          "docs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "`guide`: how recipes work."
          }
        },
        "required": [
          "recipes",
          "docs"
        ]
      },
      "RecipeExample": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Every recipe has `minimal` (required inputs only) and `full` (every input set)."
          },
          "description": {
            "type": "string",
            "description": "What this example renders."
          },
          "inputs": {
            "type": "object",
            "additionalProperties": true,
            "description": "A complete inputs object accepted by POST /renders as is."
          }
        },
        "required": [
          "name",
          "inputs"
        ]
      },
      "RecipeDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Recipe id."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "The version described."
          },
          "title": {
            "type": "string",
            "description": "Short human title."
          },
          "description": {
            "type": "string",
            "description": "What this recipe makes."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Search tags."
          },
          "preview_url": {
            "type": "string",
            "format": "uri-reference",
            "description": "Still preview image, a path on the API origin."
          },
          "inputs_summary": {
            "$ref": "#/components/schemas/InputsSummary"
          },
          "input_schema": {
            "type": "object",
            "additionalProperties": true,
            "description": "JSON Schema 2020-12 of the inputs object. Inputs listed in `required` have no default; every other input has one, so omit what you do not change. Standard input types (Media, Typography, Look) and the recipe's own types are `$defs`; `x-shown-when` marks a field that matters only when another input is set."
          },
          "asset_paths": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Paths to asset values inside inputs; '*' matches every list item. The CLI uploads file:// values found at these paths."
          },
          "output": {
            "$ref": "#/components/schemas/OutputOptions"
          },
          "examples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeExample"
            },
            "description": "Complete inputs objects; start from one and change what the user asked."
          },
          "docs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "`guide`: how recipes work; `errors`: troubleshooting."
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "description",
          "tags",
          "preview_url",
          "inputs_summary",
          "input_schema",
          "asset_paths",
          "output",
          "examples",
          "docs"
        ]
      },
      "RecipeRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Recipe id from GET /recipes."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Omit for the catalog version; a version the catalog does not serve is 404 recipe_not_found."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "OutputOptions": {
        "type": "object",
        "description": "How to encode the result, separate from the recipe inputs. Every option is optional on a render; an omitted one keeps the recipe's default (`output` of GET /recipes/{id}). An option the format does not take is a 422 invalid_output: loop only for gif, webp, apng; fps only for animated formats; svg and pdf take no other option.",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "gif",
              "webp",
              "apng",
              "mp4",
              "webm",
              "png",
              "jpeg",
              "svg",
              "pdf"
            ],
            "description": "File format. Animated: gif, webp, apng, mp4, webm; still (first frame): png, jpeg, svg, pdf."
          },
          "quality": {
            "type": "string",
            "enum": [
              "maximum",
              "normal",
              "minimal"
            ],
            "description": "Encoder quality preset; lower quality gives a smaller file. Not for svg or pdf."
          },
          "width": {
            "type": "integer",
            "minimum": 16,
            "maximum": 4000,
            "description": "Output width in pixels; height follows the canvas aspect. Rescales the rendered canvas, so one inputs object serves every size."
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5,
            "description": "Multiplier of the canvas size; when set, width is ignored. Not for svg or pdf."
          },
          "fps": {
            "type": "number",
            "minimum": 0,
            "maximum": 30,
            "description": "Frames per second, 0-30; 0 keeps the recipe's authored frame rate. Animated formats only. A GIF keeps per-frame delays, so its effective rate can be lower."
          },
          "loop": {
            "type": "boolean",
            "description": "Whether the result repeats forever (true) or plays once; gif, webp and apng only."
          }
        },
        "additionalProperties": false
      },
      "RenderRequest": {
        "type": "object",
        "properties": {
          "recipe": {
            "$ref": "#/components/schemas/RecipeRef"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": true,
            "description": "Values matching the recipe input_schema. Asset values are URLs from POST /assets or catalog asset paths; the CLI also takes file:// URLs and uploads them."
          },
          "output": {
            "$ref": "#/components/schemas/OutputOptions"
          }
        },
        "required": [
          "recipe",
          "inputs"
        ],
        "additionalProperties": false
      },
      "RenderCompleted": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          },
          "uid": {
            "type": "string",
            "description": "Render id; quote it when reporting a problem."
          },
          "result_url": {
            "type": "string",
            "description": "Downloadable result, absolute or relative to the API origin."
          },
          "format": {
            "type": "string",
            "description": "Format of the result file."
          },
